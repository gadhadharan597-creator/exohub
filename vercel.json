{
  "buildCommand": "cd frontend && npm install && npm run build && rm -rf node_modules",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "api/data/**,api/models/**,data/**,models/**",
      "excludeFiles": "{frontend/**,exoplanet_data/**,screenshot/**,docs/**,tests/**,.pytest_cache/**,.streamlit/**,.agents/**,.claude/**,exo.ipynb,exo.py,app.py,exoplanet_pipeline.py,exoplanet_habitability_rankings.csv}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
